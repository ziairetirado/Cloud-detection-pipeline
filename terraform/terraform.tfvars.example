aws_region   = "us-east-1"
project_name = "cloud-detect"
alert_email  = "you@example.com"

# CIDR ranges you consider "home turf" for console logins — office egress IP,
# VPN exit IP, etc. Logins from outside these are flagged as unknown-location.
known_ip_ranges = [
  "203.0.113.0/24"
]

flag_foreign_logins = true
allowed_countries   = ["US"]

cloudtrail_log_retention_days = 90
